{
  "name": "dopahar-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node tools/licence-audit.mjs --check && node tools/check-dup-models.js && node tools/place-visibility-check.js && vite build && node tools/char-diet.mjs && node tools/world-validator.js && node tools/slot-swap-test.js && node tools/site-slot-test.js && node tools/collision-test.js",
    "build:unchecked": "vite build && node tools/char-diet.mjs && node tools/check-budget.js",
    "preview": "vite preview",
    "check-budget": "node tools/check-budget.js",
    "shrink": "node tools/shrink.js",
    "screenshot": "node tools/screenshot.js",
    "perf-check": "node tools/perf-budget-check.js",
    "perf-check-fps": "node tools/perf-check.js",
    "budget": "node tools/check-budget.js",
    "licence": "node tools/licence-audit.mjs",
    "licence:check": "node tools/licence-audit.mjs --check",
    "budget:strict": "node tools/check-budget.js --strict",
    "perf:ride": "node tools/perf-ride.mjs",
    "perf:ride:mac": "HEADED=1 GL=metal BROWSERS=chromium,webkit node tools/perf-ride.mjs",
    "perf:instancing-test": "node tools/perf-instancing-test.mjs",
    "build:desktop": "node desktop/scripts/build-game.mjs",
    "desktop:install": "npm --prefix desktop install",
    "desktop:start": "npm --prefix desktop start",
    "desktop:mac": "npm run build:desktop && npm --prefix desktop run dist:mac",
    "desktop:win": "npm run build:desktop && npm --prefix desktop run dist:win"
  },
  "dependencies": {
    "three": "^0.186.0",
    "postprocessing": "^6.39.5"
  },
  "devDependencies": {
    "vite": "^8.3.0",
    "@gltf-transform/cli": "^4.5.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "meshoptimizer": "^1.2.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4"
  }
}
