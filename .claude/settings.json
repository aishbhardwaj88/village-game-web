    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(rmdir *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git push*)",
      "Bash(git branch -D *)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(gh *)",
      "Bash(mv /Users/aish/Documents*)",
      "Bash(mv /Users/aish/Desktop*)",
      "Bash(npm publish*)",
      "Bash(brew *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(npm install -g *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Bash(cat *.env*)",
      "Bash(cat ~/.ssh*)",
      "Bash(security *)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(//Users/aish/Library/Keychains/**)",
      "Read(//Users/aish/Library/Cookies/**)",
      "Read(//Users/aish/Documents/**)",
      "Read(//Users/aish/Desktop/**)",
      "Read(//Users/aish/Downloads/**)",
      "Read(//Users/aish/Pictures/**)",
      "Edit(//Users/aish/Library/**)",
      "Edit(//Applications/**)",
      "Edit(//Users/aish/claude-workspace/Village nostalgia/**)",
      "Bash(defaults write *)",
      "Bash(osascript *)",
      "Bash(open -a Safari*)",
      "Bash(open -a *Chrome*)",
      "Bash(killall *)",
      "Bash(launchctl *)"
